//@version=6
indicator("BTC HTF Regime Filter", shorttitle="BTC Regime", overlay=true, scale=scale.right, format=format.price, max_labels_count=500, max_lines_count=100)

// ───────── Core weekly SMAs ─────────
grpC = "Core weekly SMAs"
showCore = input.bool(true, "Show group", group=grpC)
show200w = input.bool(true, "200W SMA",        inline="a", group=grpC)
col200w  = input.color(#FF3B3B, "",            inline="a", group=grpC)
show2y   = input.bool(true, "2-yr SMA (104W)", inline="b", group=grpC)
col2y    = input.color(#FF9F1A, "",            inline="b", group=grpC)
show1y   = input.bool(true, "1-yr SMA (52W)",  inline="c", group=grpC)
col1y    = input.color(#FFE01A, "",            inline="c", group=grpC)

// ───────── Bull market support band ─────────
grpB = "Bull market support band"
showBull = input.bool(true, "Show group", group=grpB)
show20w  = input.bool(true, "20W SMA",        inline="e", group=grpB)
col20w   = input.color(#00E676, "",           inline="e", group=grpB)
show21w  = input.bool(true, "21W EMA",        inline="f", group=grpB)
col21w   = input.color(#00B0FF, "",           inline="f", group=grpB)
fillBmsb = input.bool(true, "Shade band (cloud)",     inline="fb", group=grpB)
colBmsbF = input.color(color.new(#00E676, 80), "", inline="fb", group=grpB)

// ───────── Bear market resistance band ─────────
grpR = "Bear market resistance band"
showBearG = input.bool(true, "Show group", group=grpR)
show20d   = input.bool(true, "20D SMA",       inline="g", group=grpR)
col20d    = input.color(#E040FB, "",          inline="g", group=grpR)
show50d   = input.bool(true, "50D SMA",       inline="h", group=grpR)
col50d    = input.color(#FF4081, "",          inline="h", group=grpR)
showVw    = input.bool(true, "200D VWAP",     inline="i", group=grpR)
colVw     = input.color(#00FFFF, "",          inline="i", group=grpR)
fillBear  = input.bool(true, "Shade band (cloud around all 3 lines)", inline="fr", group=grpR)
colBearF  = input.color(color.new(#FF4081, 80), "", inline="fr", group=grpR)

// ───────── Other ─────────
grpO = "Other"
show200d = input.bool(true, "200D SMA",       inline="d", group=grpO)
col200d  = input.color(#FFFFFF, "",           inline="d", group=grpO)

// ───────── Style ─────────
grpS = "Style"
lw         = input.int(3, "Line width", minval=1, maxval=6, group=grpS)
showLbl    = input.bool(false, "Name + price labels at right edge", group=grpS)
lblOff     = input.int(6, "Label offset (bars right of last bar)", minval=0, maxval=100, group=grpS)
lblSize    = input.string(size.normal, "Label size", options=[size.small, size.normal, size.large], group=grpS)

// group masters applied to each line
v200w = showCore and show200w
v2y   = showCore and show2y
v1y   = showCore and show1y
v20w  = showBull and show20w
v21w  = showBull and show21w
vBmsb = showBull and fillBmsb
v20d  = showBearG and show20d
v50d  = showBearG and show50d
vVw   = showBearG and showVw
vBear = showBearG and fillBear

// ───────── Cross markers ─────────
grpX = "Cross markers"
mkGD   = input.bool(true,  "Golden / death cross (50D vs 200D SMA)", group=grpX)
mkYY   = input.bool(true,  "1-yr vs 2-yr SMA cross", group=grpX)
mkReg  = input.bool(true,  "Regime changes (Bull / Transition / Bear)", group=grpX)
mkVw   = input.bool(false, "Daily close reclaims / loses 200D VWAP", group=grpX)
mkBm   = input.bool(false, "Daily close reclaims / loses BMSB", group=grpX)
mkUp   = input.color(#00E676, "Bullish marker", inline="mk", group=grpX)
mkDn   = input.color(#FF1744, "Bearish marker", inline="mk", group=grpX)

// ───────── Regime state ─────────
grpT = "Regime state"
showTbl    = input.bool(true, "Show table", group=grpT)
tblPos     = input.string(position.bottom_left, "Table position", options=[position.top_right, position.middle_right, position.bottom_right, position.top_left, position.middle_left, position.bottom_left], group=grpT)
tblSize    = input.string(size.normal, "Table text size", options=[size.small, size.normal, size.large], group=grpT)
showTint   = input.bool(true, "Background tint by regime", group=grpT)
tintTransp = input.int(90, "Tint transparency", minval=50, maxval=100, group=grpT)
colBull    = input.color(#00E676, "Bull",       inline="r", group=grpT)
colTran    = input.color(#FFD600, "Transition", inline="r", group=grpT)
colBear    = input.color(#FF1744, "Bear",       inline="r", group=grpT)

// ───────── Data (same values on any chart timeframe) ─────────
// Smooth mode: weekly MAs computed on daily bars at 7x length (BTC trades 7 days/week),
// so they curve with price instead of stair-stepping once a week.
smooth = input.bool(true, "Smooth weekly lines (daily-equivalent lengths)", group=grpS)
[sw200, sw104, sw52, sw20, sw21] = request.security(syminfo.tickerid, "D", [ta.sma(close, 1400), ta.sma(close, 728), ta.sma(close, 364), ta.sma(close, 140), ta.ema(close, 147)])
[ww200, ww104, ww52, ww20, ww21] = request.security(syminfo.tickerid, "W", [ta.sma(close, 200), ta.sma(close, 104), ta.sma(close, 52), ta.sma(close, 20), ta.ema(close, 21)])
w200 = smooth ? sw200 : ww200
w104 = smooth ? sw104 : ww104
w52  = smooth ? sw52  : ww52
w20  = smooth ? sw20  : ww20
w21  = smooth ? sw21  : ww21
[d20, d50, d200, dvw, dc]   = request.security(syminfo.tickerid, "D", [ta.sma(close, 20), ta.sma(close, 50), ta.sma(close, 200), math.sum(hlc3 * volume, 200) / math.sum(volume, 200), close])
// gaps 5 days ago, for the cross-watch rows (pace of convergence)
[gGD5, gYY5] = request.security(syminfo.tickerid, "D", [(ta.sma(close, 50) - ta.sma(close, 200))[5], (ta.sma(close, 364) - ta.sma(close, 728))[5]])

// ───────── Plots ─────────
plot(w200, "200W SMA", col200w, lw, display = v200w ? display.all : display.none)
plot(w104, "2-yr SMA", col2y, lw, display = v2y ? display.all : display.none)
plot(w52, "1-yr SMA", col1y, lw, display = v1y ? display.all : display.none)
plot(d200, "200D SMA", col200d, lw, display = show200d ? display.all : display.none)
plot(w20, "BMSB 20W SMA", col20w, lw, display = v20w ? display.all : display.none)
plot(w21, "BMSB 21W EMA", col21w, lw, display = v21w ? display.all : display.none)
plot(d20, "20D SMA", col20d, lw, display = v20d ? display.all : display.none)
plot(d50, "50D SMA", col50d, lw, display = v50d ? display.all : display.none)
plot(dvw, "200D VWAP", colVw, lw, display = vVw ? display.all : display.none)
// Clouds: shade from the lowest to the highest line in each band
pBullHi = plot(math.max(w20, w21), "BMSB cloud top", display=display.none)
pBullLo = plot(math.min(w20, w21), "BMSB cloud bottom", display=display.none)
fill(pBullHi, pBullLo, colBmsbF, "BMSB cloud", display = vBmsb ? display.all : display.none)
bearHi = na(dvw) ? math.max(d20, d50) : math.max(d20, d50, dvw)
bearLo = na(dvw) ? math.min(d20, d50) : math.min(d20, d50, dvw)
pBearHi = plot(bearHi, "Bear cloud top", display=display.none)
pBearLo = plot(bearLo, "Bear cloud bottom", display=display.none)
fill(pBearHi, pBearLo, colBearF, "Bear resistance cloud", display = vBear ? display.all : display.none)

// ───────── Regime ─────────
// Bull: daily close above the whole BMSB AND above the 200D VWAP
// Bear: daily close below the whole BMSB AND below the 200D VWAP
// Transition: anything mixed
vwRef  = na(dvw) ? d200 : dvw          // falls back to 200D SMA if the symbol has no volume
bHi    = math.max(w20, w21)
bLo    = math.min(w20, w21)
regime = dc > bHi and dc > vwRef ? 1 : dc < bLo and dc < vwRef ? -1 : 0
regCol = regime == 1 ? colBull : regime == -1 ? colBear : colTran
regTxt = regime == 1 ? "BULL" : regime == -1 ? "BEAR" : "TRANSITION"
bgcolor(showTint ? color.new(regCol, tintTransp) : na, title="Regime tint")

// ───────── Cross markers ─────────
golden = ta.crossover(d50, d200)
death  = ta.crossunder(d50, d200)
yyUp   = ta.crossover(w52, w104)
yyDn   = ta.crossunder(w52, w104)
regChg = regime != regime[1] and not na(regime[1])
// markers drawn as labels (no plot budget used)
f_mk(bool cond, float y, string yl, string st, string txt, color col) =>
    if cond
        label.new(bar_index, na(y) ? close : y, txt, yloc = yl == "above" ? yloc.abovebar : yl == "below" ? yloc.belowbar : yloc.price, style=st, color=col, textcolor=col, size=size.tiny)
f_mk(mkGD and golden, d200, "price", label.style_xcross, "Golden", mkUp)
f_mk(mkGD and death,  d200, "price", label.style_xcross, "Death",  mkDn)
f_mk(mkYY and yyUp,   w104, "price", label.style_xcross, "1Y>2Y",  mkUp)
f_mk(mkYY and yyDn,   w104, "price", label.style_xcross, "1Y<2Y",  mkDn)
f_mk(mkReg and regChg and regime == 1,  na, "below", label.style_triangleup,   "Bull",  colBull)
f_mk(mkReg and regChg and regime == 0,  na, "above", label.style_diamond,      "Trans", colTran)
f_mk(mkReg and regChg and regime == -1, na, "above", label.style_triangledown, "Bear",  colBear)
f_mk(mkVw and ta.crossover(dc, vwRef),  vwRef, "price", label.style_triangleup,   "VWAP", mkUp)
f_mk(mkVw and ta.crossunder(dc, vwRef), vwRef, "price", label.style_triangledown, "VWAP", mkDn)
f_mk(mkBm and ta.crossover(dc, bHi),    bHi,   "price", label.style_triangleup,   "BMSB", mkUp)
f_mk(mkBm and ta.crossunder(dc, bLo),   bLo,   "price", label.style_triangledown, "BMSB", mkDn)

// ───────── 4-year cycle clock (anchored to halvings) ─────────
// Phase windows in months after each halving, from 2016/2020/2024 history:
// tops came at 17-18 mo, bottoms at 29-30 mo.
grpY = "Cycle timing"
showStrip = input.bool(true, "Phase strip across top", group=grpY)
showCyc   = input.bool(true, "Cycle header (phase + read)", group=grpY)
showProj  = input.bool(true, "Project future phases (dashed lines)", group=grpY)
cycPos    = input.string(position.top_center, "Header position", options=[position.top_center, position.top_left, position.top_right, position.bottom_center], group=grpY)
// Three parent phases, each with two sub-phases in shades of one color
cExp  = input.color(#00C853, "Bull · Expansion",              inline="y1", group=grpY)
cTop  = input.color(#B9F6CA, "Bull · Topping",                inline="y1", group=grpY)
cOut  = input.color(#D50000, "Bear · Stay out",               inline="y2", group=grpY)
cAcc  = input.color(#FF8A80, "Bear · Bottom accumulation",    inline="y2", group=grpY)
cUnc  = input.color(#FFAB00, "Transition · Uncertainty",      inline="y3", group=grpY)
cChop = input.color(#FFF176, "Transition · Halving chop",     inline="y3", group=grpY)

MS_MO = 30.44 * 86400000.0
var array<int> halvings = array.from(timestamp("UTC", 2012, 11, 28), timestamp("UTC", 2016, 7, 9), timestamp("UTC", 2020, 5, 11), timestamp("UTC", 2024, 4, 19), timestamp("UTC", 2028, 4, 15), timestamp("UTC", 2032, 4, 10))
var int lastKnown = timestamp("UTC", 2024, 4, 19)   // later dates are estimates

f_lastHalving(int t) =>
    int h = na
    for x in halvings
        if x <= t
            h := x
    h

f_phase(float m) => not na(m) ? (m < 6 ? 0 : m < 15 ? 1 : m < 20 ? 2 : m < 27 ? 3 : m < 33 ? 4 : 5) : na
// 0 Halving chop (0-6 mo) · 1 Expansion (6-15) · 2 Topping (15-20) · 3 Stay out (20-27) · 4 Bottom accumulation (27-33) · 5 Uncertainty (33 to next halving)
f_pName(int p)   => p == 0 ? "Halving chop" : p == 1 ? "Expansion" : p == 2 ? "Topping" : p == 3 ? "Stay out" : p == 4 ? "Bottom accumulation" : p == 5 ? "Uncertainty" : ""
f_pParent(int p) => p == 1 or p == 2 ? "BULL" : p == 3 or p == 4 ? "BEAR" : "TRANSITION"
f_pCol(int p)    => p == 0 ? cChop : p == 1 ? cExp : p == 2 ? cTop : p == 3 ? cOut : p == 4 ? cAcc : cUnc

hNow   = f_lastHalving(time)
moNow  = na(hNow) ? na : (time - hNow) / MS_MO
phase  = f_phase(moNow)
phCol  = f_pCol(phase)
phNew  = phase != phase[1]

plotshape(showStrip and not na(phase), "Cycle strip", shape.square, location.top, phCol, size=size.tiny)
plotchar(showStrip and phNew and phase == 0, "Strip: Halving chop", "▾", location.top, cChop, text="Transition · Halving chop",  textcolor=cChop, size=size.tiny)
plotchar(showStrip and phNew and phase == 1, "Strip: Expansion",    "▾", location.top, cExp,  text="Bull · Expansion",           textcolor=cExp,  size=size.tiny)
plotchar(showStrip and phNew and phase == 2, "Strip: Topping",      "▾", location.top, cTop,  text="Bull · Topping",             textcolor=cTop,  size=size.tiny)
plotchar(showStrip and phNew and phase == 3, "Strip: Stay out",     "▾", location.top, cOut,  text="Bear · Stay out",            textcolor=cOut,  size=size.tiny)
plotchar(showStrip and phNew and phase == 4, "Strip: Bottom acc.",  "▾", location.top, cAcc,  text="Bear · Bottom accumulation", textcolor=cAcc,  size=size.tiny)
plotchar(showStrip and phNew and phase == 5, "Strip: Uncertainty",  "▾", location.top, cUnc,  text="Transition · Uncertainty",   textcolor=cUnc,  size=size.tiny)

// Interpretive read: cycle phase x regime (from the 2016-2026 chop study)
f_read(int p, int r) =>
    p == 4 ? (r == -1 ? "Bottom window, regime still BEAR: ladder buys, expect chop until BMSB/VWAP reclaim" : r == 0 ? "Bottom window, regime turning: watch for a held reclaim of the bands" : "Bottom window + BULL: early-cycle reclaims have tended to hold") :
     p == 5 ? (r == 1 ? "Pre-halving uncertainty, regime BULL: pre-top chop resolved UP 4 of 4" : "Pre-halving uncertainty: weakness has been a buy in this phase") :
     p == 0 ? "Halving chop is normal (2020, 2024): flips here resolved UP; accumulate through them" :
     p == 1 ? (r == 1 ? "Expansion: trend phase, hold" : "Mid-bull pause: chop in this phase resolved UP historically") :
     p == 2 ? (r == 1 ? "Top window (tops at 17-18 mo): plan time-based exits" : "Top window + weakening regime: take profit") :
     p == 3 ? (r == 1 ? "Bear phase: post-top BULL flips have been traps (2 of 2)" : "Bear phase: patience; bottom window opens ~27 mo") : ""

// next phase boundary after now
f_nextBoundary(int t) =>
    int bestT = na
    int bestP = na
    for h in halvings
        for [i, m] in array.from(0.0, 6.0, 15.0, 20.0, 27.0, 33.0)
            int bt = h + math.round(m * MS_MO)
            if bt > t and (na(bestT) or bt < bestT)
                bestT := bt
                bestP := i
    [bestT, bestP]

yTop = ta.highest(high, 150)
var table cyc = table.new(cycPos, 1, 2, border_width=0)
var array<line>  projL = array.new<line>()
var array<label> projB = array.new<label>()
if barstate.islast
    [nT, nP] = f_nextBoundary(time)
    if showCyc and not na(phase)
        hTxt = "Cycle: " + f_pParent(phase) + " · " + str.upper(f_pName(phase)) + "  ·  month " + str.tostring(math.floor(moNow)) + " since halving  ·  next: " + f_pParent(nP) + " · " + f_pName(nP) + " ~" + str.format_time(nT, "MMM yyyy", "UTC")
        table.cell(cyc, 0, 0, hTxt, text_color=phCol, bgcolor=color.new(color.black, 25), text_size=size.small)
        table.cell(cyc, 0, 1, f_read(phase, regime), text_color=color.white, bgcolor=color.new(color.black, 25), text_size=size.small)
    for l in projL
        line.delete(l)
    for b in projB
        label.delete(b)
    array.clear(projL)
    array.clear(projB)
    if showProj
        for h in halvings
            for [i, m] in array.from(0.0, 6.0, 15.0, 20.0, 27.0, 33.0)
                int bt = h + math.round(m * MS_MO)
                if bt > time and bt < time + int(60 * MS_MO)
                    array.push(projL, line.new(bt, close, bt, close * 1.01, xloc=xloc.bar_time, extend=extend.both, color=f_pCol(i), style=line.style_dashed, width=2))
                    array.push(projB, label.new(bt, yTop, f_pParent(i) + " · " + f_pName(i) + (h > lastKnown and i == 0 ? " (est.)" : ""), xloc=xloc.bar_time, style=label.style_label_left, color=f_pCol(i), textcolor=color.black, size=size.small))

f_up(float v) => na(v) ? 0 : dc > v ? 1 : 0
score = f_up(w200) + f_up(w104) + f_up(w52) + f_up(d200) + f_up(w20) + f_up(w21) + f_up(d20) + f_up(d50) + f_up(dvw)

f_fmt(float v) => str.tostring(v, "#,###")

// ───────── Labels ─────────
var array<label> lbls = array.new<label>()
f_add(bool ok, float y, string name, color col) =>
    if ok and not na(y)
        array.push(lbls, label.new(bar_index + lblOff, y, name + "  " + f_fmt(y), xloc=xloc.bar_index, color=col, style=label.style_label_left, textcolor=color.black, size=lblSize))

if barstate.islast
    for l in lbls
        label.delete(l)
    array.clear(lbls)
    if showLbl
        f_add(v200w, w200, "200W SMA",     col200w)
        f_add(v2y,   w104, "2-yr SMA",     col2y)
        f_add(v1y,   w52,  "1-yr SMA",     col1y)
        f_add(show200d, d200, "200D SMA",     col200d)
        f_add(v20w,  w20,  "BMSB 20W SMA", col20w)
        f_add(v21w,  w21,  "BMSB 21W EMA", col21w)
        f_add(v20d,  d20,  "20D SMA",      col20d)
        f_add(v50d,  d50,  "50D SMA",      col50d)
        f_add(vVw,   dvw,  "200D VWAP",    colVw)

// ───────── Table ─────────
var table tbl = table.new(tblPos, 4, 15, border_width=1)
bgc = color.new(color.black, 15)

f_cell(int c, int r, string txt, color tc) =>
    table.cell(tbl, c, r, txt, text_color=tc, bgcolor=bgc, text_size=tblSize, text_halign=text.align_left)

f_row(int r, string name, float v, color col) =>
    dist  = na(v) ? na : (v / dc - 1) * 100
    above = dc > v
    f_cell(0, r, name, col)
    f_cell(1, r, na(v) ? "n/a" : f_fmt(v), color.white)
    f_cell(2, r, na(dist) ? "" : (dist >= 0 ? "+" : "") + str.tostring(dist, "0.0") + "%", color.white)
    f_cell(3, r, na(v) ? "" : above ? "Above" : "Below", above ? colBull : colBear)

// gap = fast minus slow; pace = linear days to cross if the last 5 days' convergence continues
f_watch(int r, string name, float gap, float gap5, string dnTxt, string upTxt) =>
    rate   = (gap5 - gap) / 5                     // per-day move of the gap toward zero (if same sign as gap)
    closing = not na(rate) and rate != 0 and math.sign(rate) == math.sign(gap)
    days   = closing ? gap / rate : na
    f_cell(0, r, name, color.white)
    f_cell(1, r, na(gap) ? "n/a" : (gap >= 0 ? "+" : "") + f_fmt(gap), color.white)
    f_cell(2, r, closing ? "~" + str.tostring(math.round(days)) + "d" : "widening", closing ? colTran : color.gray)
    nextTxt = closing ? (gap >= 0 ? dnTxt : upTxt) + " watch" : (gap >= 0 ? "Bull side" : "Bear side")
    nextCol = closing ? (gap >= 0 ? colBear : colBull) : (gap >= 0 ? colBull : colBear)
    f_cell(3, r, nextTxt, nextCol)

if barstate.islast and showTbl
    f_cell(0, 0, "Line", color.gray)
    f_cell(1, 0, "Level", color.gray)
    f_cell(2, 0, "To level", color.gray)
    f_cell(3, 0, "Price is", color.gray)
    f_row(1, "200W SMA",     w200, col200w)
    f_row(2, "2-yr SMA",     w104, col2y)
    f_row(3, "1-yr SMA",     w52,  col1y)
    f_row(4, "200D SMA",     d200, col200d)
    f_row(5, "BMSB 20W SMA", w20,  col20w)
    f_row(6, "BMSB 21W EMA", w21,  col21w)
    f_row(7, "20D SMA",      d20,  col20d)
    f_row(8, "50D SMA",      d50,  col50d)
    f_row(9, "200D VWAP",    dvw,  colVw)
    f_cell(0, 10, "Regime", color.white)
    f_cell(1, 10, regTxt, regCol)
    f_cell(2, 10, "Above", color.white)
    f_cell(3, 10, str.tostring(score) + " of 9", regCol)
    f_cell(0, 11, "Daily close", color.gray)
    f_cell(1, 11, f_fmt(dc), color.white)
    f_cell(2, 11, "", color.white)
    f_cell(3, 11, "", color.white)
    f_watch(13, "50D vs 200D", d50 - d200, gGD5, "Death cross", "Golden cross")
    f_watch(14, "1Y vs 2Y SMA", w52 - w104, gYY5, "1Y < 2Y", "1Y > 2Y")
    f_cell(0, 12, "Cross watch", color.gray)
    f_cell(1, 12, "Gap", color.gray)
    f_cell(2, 12, "Pace", color.gray)
    f_cell(3, 12, "Next", color.gray)
