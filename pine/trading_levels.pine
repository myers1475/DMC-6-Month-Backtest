// Trading Levels: where a long candle meets a short candle (bodies only, wicks ignored)
// Bottom level: a bear candle followed by a bull candle -> the bull candle's OPEN
// Top level:    a bull candle followed by a bear candle -> the bear candle's OPEN
// Each timeframe is read on its own closed candles. Per timeframe, the nearest levels above and
// below price are drawn (counts chosen in settings). Timeframes below the chart are skipped.
//
// Level life cycle (all on the level's own timeframe, closed candles):
//  1. UNTESTED: new level. Support if below price, resistance if above (by how it formed).
//  2. First test after price has left the level:
//     - HOLDS (a candle touches it, no body close through) -> USED
//     - BREAKS (a body closes through it)                  -> FLIPPED: becomes an untested level on the
//       other side (lost support = resistance, gained resistance = support)
//  3. A FLIPPED level gets one test: holds or breaks, either way -> USED
//  4. A USED level stays (dashed) until price reaches the next level of the same timeframe in the
//     direction price moved away from it (on a break: the direction of the break). Then it is removed.

//@version=6
indicator("Trading Levels", shorttitle = "Trading Lvls", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ── Timeframes: show · levels above · levels below · line width
const string G_TF = "Timeframes (show · levels above · levels below · line width)"
bool onM   = input.bool(true, "Monthly", inline = "M", group = G_TF)
int  aM    = input.int(2, "Above", minval = 0, maxval = 50, inline = "M", group = G_TF)
int  bM    = input.int(2, "Below", minval = 0, maxval = 50, inline = "M", group = G_TF)
int  wM    = input.int(5, "Width", minval = 1, maxval = 8, inline = "M", group = G_TF)
bool onW   = input.bool(true, "Weekly", inline = "W", group = G_TF)
int  aW    = input.int(2, "Above", minval = 0, maxval = 50, inline = "W", group = G_TF)
int  bW    = input.int(2, "Below", minval = 0, maxval = 50, inline = "W", group = G_TF)
int  wW    = input.int(4, "Width", minval = 1, maxval = 8, inline = "W", group = G_TF)
bool onD   = input.bool(true, "Daily", inline = "D", group = G_TF)
int  aD    = input.int(2, "Above", minval = 0, maxval = 50, inline = "D", group = G_TF)
int  bD    = input.int(2, "Below", minval = 0, maxval = 50, inline = "D", group = G_TF)
int  wD    = input.int(3, "Width", minval = 1, maxval = 8, inline = "D", group = G_TF)
bool on4H  = input.bool(true, "4H", inline = "4H", group = G_TF)
int  a4H   = input.int(2, "Above", minval = 0, maxval = 50, inline = "4H", group = G_TF)
int  b4H   = input.int(2, "Below", minval = 0, maxval = 50, inline = "4H", group = G_TF)
int  w4H   = input.int(3, "Width", minval = 1, maxval = 8, inline = "4H", group = G_TF)
bool on1H  = input.bool(true, "1H", inline = "1H", group = G_TF)
int  a1H   = input.int(2, "Above", minval = 0, maxval = 50, inline = "1H", group = G_TF)
int  b1H   = input.int(2, "Below", minval = 0, maxval = 50, inline = "1H", group = G_TF)
int  w1H   = input.int(2, "Width", minval = 1, maxval = 8, inline = "1H", group = G_TF)
bool on15  = input.bool(false, "15m", inline = "15", group = G_TF)
int  a15   = input.int(2, "Above", minval = 0, maxval = 50, inline = "15", group = G_TF)
int  b15   = input.int(2, "Below", minval = 0, maxval = 50, inline = "15", group = G_TF)
int  w15   = input.int(2, "Width", minval = 1, maxval = 8, inline = "15", group = G_TF)
bool on5   = input.bool(false, "5m", inline = "5", group = G_TF)
int  a5    = input.int(2, "Above", minval = 0, maxval = 50, inline = "5", group = G_TF)
int  b5    = input.int(2, "Below", minval = 0, maxval = 50, inline = "5", group = G_TF)
int  w5    = input.int(2, "Width", minval = 1, maxval = 8, inline = "5", group = G_TF)

// ── Levels
const string G_LV = "Levels"
bool   showTop  = input.bool(true, "Top levels (bull → bear)", group = G_LV)
bool   showBot  = input.bool(true, "Bottom levels (bear → bull)", group = G_LV)
bool   showUsed = input.bool(true, "Show used levels (dashed) until price reaches the next level", group = G_LV)

// ── Colors & labels
const string G_C = "Colors & labels"
color cTop     = input.color(#FF9F1C, "Resistance color", group = G_C)
color cBot     = input.color(#00E5FF, "Support color", group = G_C)
bool  showLbl  = input.bool(true, "Labels (timeframe + price)", group = G_C)
color cLblText = input.color(#000000, "Label text color", group = G_C)

const int STORE_CAP = 300   // levels remembered per timeframe (oldest dropped first)

// state: 0 untested, 1 flipped (untested on the new side), 2 used (waiting for the next level)
type LvlSet
    array<float> px
    array<int>   side    // 1 resistance, -1 support
    array<int>   t
    array<int>   state
    array<bool>  armed   // price has left the level since it formed / flipped
    array<int>   dir     // used levels: direction price is travelling (1 up, -1 down)
    int          done = 0  // open time of the last candle already processed

f_new() =>
    LvlSet.new(array.new<float>(), array.new<int>(), array.new<int>(), array.new<int>(), array.new<bool>(), array.new<int>())

var LvlSet sM  = f_new()
var LvlSet sW  = f_new()
var LvlSet sD  = f_new()
var LvlSet s4H = f_new()
var LvlSet s1H = f_new()
var LvlSet s15 = f_new()
var LvlSet s5  = f_new()

f_remove(LvlSet s, int i) =>
    array.remove(s.px, i)
    array.remove(s.side, i)
    array.remove(s.t, i)
    array.remove(s.state, i)
    array.remove(s.armed, i)
    array.remove(s.dir, i)
    true

f_add(LvlSet s, float px, int side, int t) =>
    array.push(s.px, px)
    array.push(s.side, side)
    array.push(s.t, t)
    array.push(s.state, 0)
    array.push(s.armed, false)
    array.push(s.dir, 0)
    if array.size(s.px) > STORE_CAP
        f_remove(s, 0)
    true

// Nearest other level beyond px in direction d (na if none)
f_next(LvlSet s, int skip, float px, int d) =>
    float best = na
    for k = 0 to array.size(s.px) - 1
        if k != skip
            float q = array.get(s.px, k)
            if (d == 1 and q > px) or (d == -1 and q < px)
                best := na(best) ? q : d == 1 ? math.min(best, q) : math.max(best, q)
    best

// Update every level with the candle that just closed on this timeframe (h, l, c)
f_update(LvlSet s, float h, float l, float c) =>
    int i = array.size(s.px) - 1
    while i >= 0
        float px  = array.get(s.px, i)
        int   sd  = array.get(s.side, i)
        int   st  = array.get(s.state, i)
        bool  arm = array.get(s.armed, i)
        bool  touched = l <= px and h >= px
        bool  broke   = sd == 1 ? c > px : c < px
        if broke
            array.set(s.side, i, -sd)                 // role flips on every close through
            if st == 0
                array.set(s.state, i, 1)              // first break: fresh flipped level
                array.set(s.armed, i, false)
            else
                array.set(s.state, i, 2)              // flipped or used level broken: used, travelling the way it broke
                array.set(s.dir, i, sd)
        else if st != 2 and arm and touched
            array.set(s.state, i, 2)                  // held: used, travelling away from it
            array.set(s.dir, i, -sd)
        else if st != 2 and not touched
            array.set(s.armed, i, true)
        bool gone = false
        if array.get(s.state, i) == 2
            int   d  = array.get(s.dir, i)
            float nx = f_next(s, i, px, d)
            if not na(nx) and (d == 1 ? h >= nx : l <= nx)
                gone := true
        if gone
            f_remove(s, i)
        i -= 1
    true

f_process(LvlSet s, float o1, float h1, float l1, float c1, float o2, float c2, int t1) =>
    f_update(s, h1, l1, c1)
    if showTop and c2 > o2 and c1 < o1
        f_add(s, o1, 1, t1)
    if showBot and c2 < o2 and c1 > o1
        f_add(s, o1, -1, t1)
    s.done := t1
    true

// A candle is processed as soon as it is finished: either the chart bar that ends it has closed
// (also true for the last candle when the market is shut, e.g. the weekend), or, as a fallback,
// when the next candle of that timeframe has started.
f_run(bool on, string tf, LvlSet s, float o0, float h0, float l0, float c0, float oP, float cP, int t0, int tc0, float o1, float h1, float l1, float c1, float o2, float c2, int t1) =>
    if on and timeframe.in_seconds(tf) >= timeframe.in_seconds()
        if not na(t1) and t1 > s.done
            f_process(s, o1, h1, l1, c1, o2, c2, t1)
        if not na(t0) and not na(tc0) and t0 > s.done and time_close >= tc0 and (barstate.isconfirmed or timenow >= tc0)
            f_process(s, o0, h0, l0, c0, oP, cP, t0)
    true

// ── One request per timeframe: the current candle (final values once it is finished) plus the two before it
f_req(string tf) =>
    request.security(syminfo.tickerid, tf, [open, high, low, close, open[1], close[1], time, time_close, open[1], high[1], low[1], close[1], open[2], close[2], time[1]], lookahead = barmerge.lookahead_on)

[oM0, hM0, lM0, cM0, oMP, cMP, tM0, xM0, oM1, hM1, lM1, cM1, oM2, cM2, tM1] = f_req("M")
[oW0, hW0, lW0, cW0, oWP, cWP, tW0, xW0, oW1, hW1, lW1, cW1, oW2, cW2, tW1] = f_req("W")
[oD0, hD0, lD0, cD0, oDP, cDP, tD0, xD0, oD1, hD1, lD1, cD1, oD2, cD2, tD1] = f_req("D")
[o40, h40, l40, c40, o4P, c4P, t40, x40, o41, h41, l41, c41, o42, c42, t41] = f_req("240")
[oH0, hH0, lH0, cH0, oHP, cHP, tH0, xH0, oH1, hH1, lH1, cH1, oH2, cH2, tH1] = f_req("60")
[oF0, hF0, lF0, cF0, oFP, cFP, tF0, xF0, oF1, hF1, lF1, cF1, oF2, cF2, tF1] = f_req("15")
[o50, h50, l50, c50, o5P, c5P, t50, x50, o51, h51, l51, c51, o52, c52, t51] = f_req("5")

f_run(onM,  "M",   sM,  oM0, hM0, lM0, cM0, oMP, cMP, tM0, xM0, oM1, hM1, lM1, cM1, oM2, cM2, tM1)
f_run(onW,  "W",   sW,  oW0, hW0, lW0, cW0, oWP, cWP, tW0, xW0, oW1, hW1, lW1, cW1, oW2, cW2, tW1)
f_run(onD,  "D",   sD,  oD0, hD0, lD0, cD0, oDP, cDP, tD0, xD0, oD1, hD1, lD1, cD1, oD2, cD2, tD1)
f_run(on4H, "240", s4H, o40, h40, l40, c40, o4P, c4P, t40, x40, o41, h41, l41, c41, o42, c42, t41)
f_run(on1H, "60",  s1H, oH0, hH0, lH0, cH0, oHP, cHP, tH0, xH0, oH1, hH1, lH1, cH1, oH2, cH2, tH1)
f_run(on15, "15",  s15, oF0, hF0, lF0, cF0, oFP, cFP, tF0, xF0, oF1, hF1, lF1, cF1, oF2, cF2, tF1)
f_run(on5,  "5",   s5,  o50, h50, l50, c50, o5P, c5P, t50, x50, o51, h51, l51, c51, o52, c52, t51)

// ── Draw the nearest levels above / below price per timeframe, redrawn on the latest bar
var array<line>  drawnL = array.new<line>()
var array<label> drawnB = array.new<label>()

f_pick(LvlSet s, bool above, int n) =>
    array<int> out = array.new<int>()
    int sz = array.size(s.px)
    if n > 0 and sz > 0
        array<float> dist = array.new<float>()
        array<int>   ids  = array.new<int>()
        for i = 0 to sz - 1
            float px = array.get(s.px, i)
            bool  ok = showUsed or array.get(s.state, i) != 2
            if ok and (above ? px >= close : px < close)
                array.push(dist, math.abs(px - close))
                array.push(ids, i)
        if array.size(ids) > 0
            array<int> ord = array.sort_indices(dist, order.ascending)
            for k = 0 to math.min(n, array.size(ids)) - 1
                array.push(out, array.get(ids, array.get(ord, k)))
    out

f_draw(bool on, string tf, LvlSet s, int nUp, int nDn, int w, string tag) =>
    if on and timeframe.in_seconds(tf) >= timeframe.in_seconds() and array.size(s.px) > 0
        array<int> sel = array.concat(f_pick(s, true, nUp), f_pick(s, false, nDn))
        for j in sel
            float px   = array.get(s.px, j)
            int   st   = array.get(s.state, j)
            int   t0   = math.min(array.get(s.t, j), time - 1)
            color c    = array.get(s.side, j) == 1 ? cTop : cBot
            string tg  = tag + (st == 1 ? " flip" : st == 2 ? " used" : "")
            array.push(drawnL, line.new(t0, px, time, px, xloc = xloc.bar_time, extend = extend.right, color = c, width = w, style = st == 2 ? line.style_dashed : line.style_solid))
            if showLbl
                array.push(drawnB, label.new(bar_index + 2, px, tg + " " + str.tostring(px, format.mintick), style = label.style_label_left, color = c, textcolor = cLblText, size = size.small))
    true

if barstate.islast
    for l in drawnL
        line.delete(l)
    for b in drawnB
        label.delete(b)
    array.clear(drawnL)
    array.clear(drawnB)
    f_draw(onM,  "M",   sM,  aM,  bM,  wM,  "M")
    f_draw(onW,  "W",   sW,  aW,  bW,  wW,  "W")
    f_draw(onD,  "D",   sD,  aD,  bD,  wD,  "D")
    f_draw(on4H, "240", s4H, a4H, b4H, w4H, "4H")
    f_draw(on1H, "60",  s1H, a1H, b1H, w1H, "1H")
    f_draw(on15, "15",  s15, a15, b15, w15, "15m")
    f_draw(on5,  "5",   s5,  a5,  b5,  w5,  "5m")
